# ---------------------------------------------------------------------------
# Firmitas — backend environment template
#
# Copy to `.env` and fill in real values. Never commit the real `.env`.
#
# This project owns the "Firmitas" database ONLY. Other projects on the same
# MongoDB cluster (TechnoSales, ShreeRajTrader, ...) have their own databases
# and must never be referenced from here.
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/Firmitas
#
# Production (MongoDB Atlas) — note the database name at the end of the path,
# it is what isolates this project from the others on the same cluster:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Firmitas?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production if these are unset.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated list of browser origins allowed to call this API.
# Must include the deployed frontend origin (no trailing slash), or the browser
# blocks every request with a CORS error.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://firmitas-1.onrender.com

# Credentials created by `npm run seed` for the first super admin login.
# Change SEED_ADMIN_PASSWORD before seeding a production database.
SEED_ADMIN_EMAIL=admin@firmitas.com
SEED_ADMIN_PASSWORD=Admin@123
